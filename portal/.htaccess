# portal.duqueimmigration.ca only. The same folder is also reachable as
# duqueimmigration.ca/portal/ (it sits inside the main site's folder);
# that second address is refused so there's exactly one way in.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} !^portal\.duqueimmigration\.ca$ [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ - [F,L]
# Partials, config and stray files are never requested directly.
RewriteRule (^|/)(_[^/]*\.php|config(\.example)?\.php|.*\.(sql|md|log|bak|old|orig|swp|tar|gz|zip))$ - [F,L,NC]
# Hidden files too, except /.well-known/ (certificate renewal uses it).
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
</IfModule>
Options -Indexes
